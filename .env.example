API_PORT=3000
WEB_PORT=3001
CHAT_SESSION_TTL_SECONDS=14400
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=30000

# Replace every development placeholder before deploying to production.
REDIS_PASSWORD=change-me-in-production
QDRANT_API_KEY=change-me-in-production

ERP_PRODUCTS_URL=http://erp-host.example/insoftApi/api/productos
ERP_INVENTORY_URL=http://erp-host.example/insoftApi/api/inventario
ERP_AUTHORIZATION=replace-with-erp-authorization
ERP_COMPANY_CODE=102
ERP_TIMEOUT_MS=60000
ERP_MAX_RETRIES=1
ERP_MAX_CONCURRENCY=2
ERP_MAX_QUEUE_SIZE=100
ERP_CACHE_TTL_SECONDS=300
ERP_CATALOG_WARM_INTERVAL_SECONDS=240
ERP_INVENTORY_SYNC_INTERVAL_SECONDS=30
ERP_INVENTORY_FRESH_SECONDS=60
ERP_INVENTORY_STALE_SECONDS=180
ERP_LOCAL_CACHE_TTL_SECONDS=30
ERP_CIRCUIT_FAILURE_THRESHOLD=5
ERP_CIRCUIT_RESET_MS=15000

REDIS_IMAGE=redis:8.8.1-alpine
QDRANT_IMAGE=qdrant/qdrant:v1.18.2
